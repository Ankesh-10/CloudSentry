{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowResourceDiscovery",
            "Effect": "Allow",
            "Action": [
                "ec2:DescribeInstances",
                "ec2:DescribeVolumes",
                "lambda:ListFunctions",
                "s3:ListAllMyBuckets",
                "rds:DescribeDBInstances"
            ],
            "Resource": "*"
        },
        {
            "Sid": "AllowTelemetryCollection",
            "Effect": "Allow",
            "Action": [
                "cloudwatch:GetMetricData"
            ],
            "Resource": "*"
        },
        {
            "Sid": "AllowSafeRemediationActions",
            "Effect": "Allow",
            "Action": [
                "ec2:StopInstances",
                "ec2:StartInstances",
                "ec2:CreateTags",
                "lambda:PutFunctionConcurrency",
                "lambda:TagResource"
            ],
            "Resource": [
                "arn:aws:ec2:*:*:instance/*",
                "arn:aws:lambda:*:*:function:*"
            ]
        }
    ]
}
