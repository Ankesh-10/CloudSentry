{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "DiscoveryRegional",
            "Effect": "Allow",
            "Action": [
                "ec2:DescribeInstances",
                "ec2:DescribeVolumes",
                "lambda:ListFunctions",
                "lambda:ListTags",
                "lambda:GetFunctionConcurrency",
                "rds:DescribeDBInstances",
                "cloudwatch:GetMetricData"
            ],
            "Resource": "*",
            "Condition": {
                "StringEquals": {"aws:RequestedRegion": "us-east-1"}
            }
        },
        {
            "Sid": "DiscoveryS3Global",
            "Effect": "Allow",
            "Action": [
                "s3:ListAllMyBuckets",
                "s3:GetBucketLocation",
                "s3:GetBucketTagging"
            ],
            "Resource": "*"
        },
        {
            "Sid": "RemediateEc2InRegion",
            "Effect": "Allow",
            "Action": [
                "ec2:StopInstances",
                "ec2:StartInstances"
            ],
            "Resource": "arn:aws:ec2:us-east-1:*:instance/*"
        },
        {
            "Sid": "RemediateLambdaInRegion",
            "Effect": "Allow",
            "Action": [
                "lambda:PutFunctionConcurrency",
                "lambda:DeleteFunctionConcurrency",
                "lambda:TagResource",
                "lambda:UntagResource"
            ],
            "Resource": "arn:aws:lambda:us-east-1:*:function:*"
        },
        {
            "Sid": "TagInRegion",
            "Effect": "Allow",
            "Action": [
                "ec2:CreateTags",
                "ec2:DeleteTags",
                "rds:AddTagsToResource",
                "rds:RemoveTagsFromResource"
            ],
            "Resource": [
                "arn:aws:ec2:us-east-1:*:instance/*",
                "arn:aws:ec2:us-east-1:*:volume/*",
                "arn:aws:rds:us-east-1:*:db:*"
            ]
        },
        {
            "Sid": "TagS3Buckets",
            "Effect": "Allow",
            "Action": "s3:PutBucketTagging",
            "Resource": "arn:aws:s3:::*"
        },
        {
            "Sid": "DenyMutatingProtectedResources",
            "Effect": "Deny",
            "Action": [
                "ec2:StopInstances",
                "ec2:StartInstances",
                "ec2:CreateTags",
                "ec2:DeleteTags",
                "lambda:PutFunctionConcurrency",
                "lambda:DeleteFunctionConcurrency",
                "lambda:TagResource",
                "lambda:UntagResource",
                "rds:AddTagsToResource",
                "rds:RemoveTagsFromResource"
            ],
            "Resource": "*",
            "Condition": {
                "StringEqualsIgnoreCase": {
                    "aws:ResourceTag/cloudsentry:protected": ["true", "yes", "1", "on"]
                }
            }
        },
        {
            "Sid": "DenyStoppingDoNotStop",
            "Effect": "Deny",
            "Action": "ec2:StopInstances",
            "Resource": "*",
            "Condition": {
                "StringEqualsIgnoreCase": {
                    "aws:ResourceTag/do-not-stop": ["true", "yes", "1", "on"]
                }
            }
        },
        {
            "Sid": "DenyTouchingProtectionTags",
            "Effect": "Deny",
            "Action": [
                "ec2:CreateTags",
                "ec2:DeleteTags",
                "lambda:TagResource",
                "lambda:UntagResource",
                "rds:AddTagsToResource",
                "rds:RemoveTagsFromResource"
            ],
            "Resource": "*",
            "Condition": {
                "ForAnyValue:StringEqualsIgnoreCase": {
                    "aws:TagKeys": ["cloudsentry:protected", "do-not-stop"]
                }
            }
        },
        {
            "Sid": "DenyDestructiveAlways",
            "Effect": "Deny",
            "Action": [
                "ec2:TerminateInstances",
                "ec2:DeleteVolume",
                "ec2:DeleteSnapshot",
                "ec2:ModifyInstanceAttribute",
                "lambda:DeleteFunction",
                "lambda:UpdateFunctionCode",
                "lambda:UpdateFunctionConfiguration",
                "lambda:GetFunction",
                "rds:DeleteDBInstance",
                "rds:StopDBInstance",
                "rds:ModifyDBInstance",
                "s3:DeleteBucket",
                "s3:DeleteObject",
                "s3:PutBucketPolicy",
                "s3:GetObject",
                "iam:*",
                "sts:AssumeRole"
            ],
            "Resource": "*"
        }
    ]
}
