# Copy to .env.local (git-ignored) and fill in. Everything prefixed VITE_ is
# compiled into the browser bundle: never put the service-role key here.

# Same project as the backend's SUPABASE_URL. Use the publishable key
# (Dashboard > Project Settings > API Keys, sb_publishable_...). Projects on
# legacy keys can set VITE_SUPABASE_ANON_KEY=eyJ... instead; either is public.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Production: the backend origin, e.g. https://cloudsentry-backend.onrender.com
# (and add this frontend's origin to the backend's CORS_ORIGINS).
# Leave empty in dev: Vite proxies /api to VITE_DEV_API_PROXY.
VITE_API_BASE_URL=

# Dev only: where the Vite proxy sends /api (docker compose sets http://backend:8000).
VITE_DEV_API_PROXY=http://localhost:8000
