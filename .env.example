# ── SUPABASE ──────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...              # Frontend-safe (RLS-protected)
SUPABASE_SERVICE_ROLE_KEY=eyJ...      # BACKEND ONLY — never expose
SUPABASE_JWT_SECRET=your-jwt-secret   # HS256 projects; asymmetric-key projects use the JWKS instead
JWT_AUDIENCE=authenticated
# JWT_ISSUER=                         # default: <SUPABASE_URL>/auth/v1
# Access control (comma-separated Supabase user ids). Users can instead get
# app_metadata.cloudsentry_role = viewer | operator | admin.
OPERATOR_USER_IDS=                    # may approve/execute actions and change config
VIEWER_USER_IDS=                      # read-only dashboard access
REQUIRE_VIEWER_ROLE=true              # false = any signed-in (non-anonymous) user can read
DATABASE_URL=postgresql://postgres.YOUR_REF:[YOUR-PASSWORD]@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

# ── AWS ───────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIA...             # BACKEND ONLY
AWS_SECRET_ACCESS_KEY=...             # BACKEND ONLY
AWS_DEFAULT_REGION=us-east-1

# ── MULTI-CLOUD ───────────────────────────────────────────
CLOUD_PROVIDER=aws                    # 'aws' or 'gcp'

# ── GCP (optional; incomplete vs AWS MVP) ─────────────────
GCP_PROJECT_ID=my-gcp-project
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── BACKEND ───────────────────────────────────────────────
BACKEND_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ML_ANOMALY_THRESHOLD=-0.3
ML_CONTAMINATION=0.05

# ── SAFETY ────────────────────────────────────────────────
GLOBAL_AUTOMATION_ENABLED=false
DRY_RUN_MODE=true
MAX_MONTHLY_BUDGET_USD=10.00
MAX_DAILY_SPEND_USD=2.00
MAX_ACTIONS_PER_DAY=5
ACTION_COOLDOWN_MINUTES=30
MAX_CW_API_CALLS_PER_HOUR=200
# Enabling automation / disabling dry-run via the API needs a second operator.
REQUIRE_TWO_PERSON_CONFIG=true
LAMBDA_CONCURRENCY_LIMIT=10
